{
  "name": "novapika",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:local": "vite --mode desktop",
    "cert": "node scripts/make-cert.mjs",
    "dev:api": "npm run db:local && npx --yes wrangler@4.160.0 dev --port 8787",
    "db:local": "npx --yes wrangler@4.160.0 d1 migrations apply novapika --local",
    "db:remote": "npx --yes wrangler@4.160.0 d1 migrations apply novapika --remote",
    "types": "npx --yes wrangler@4.160.0 types server/worker-configuration.d.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:helper": "vitest run tests/helperLive.test.ts",
    "deploy": "npm run build && npx --yes wrangler@4.160.0 deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "iwer": "^2.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
