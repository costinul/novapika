// Hosts the game on Cloudflare, at https://novapika.<account>.workers.dev:
// the built game (dist/) as static files, and the small API in server/ that
// keeps players and their pets. Deploy with `npm run deploy`.
{
  "name": "novapika",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    // Only the API runs server code. Everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  // Players and pets. The database is in Western Europe.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novapika",
      "database_id": "a03973da-0be7-4a9f-a0ed-8feb0d9f5c03",
      "migrations_dir": "server/migrations"
    }
  ],
  // One Durable Object per lobby: the room every player there holds a
  // WebSocket to. Once the lobby is empty it keeps only its own name and how
  // many phrases its helper parrot has answered today.
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  // Requests allowed per address per minute, so that sign-in codes and the
  // admin password cannot be guessed. Counted per Cloudflare location, so
  // the limits are approximate.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Set with `wrangler secret put ADMIN_PASSWORD`; for local work it is read
  // from .dev.vars. Never written here.
  "secrets": { "required": ["ADMIN_PASSWORD"] },
  // The helper parrot's hearing: speech to text, inside Cloudflare. Its
  // thinking and speaking need two more secrets, ANTHROPIC_API_KEY and
  // OPENAI_API_KEY, set the same way. Without them the game runs as before
  // and the helper parrot stays silent.
  "ai": { "binding": "AI" },
  // Once a day, what was said to the helper parrot more than a week ago is
  // forgotten.
  "triggers": { "crons": ["17 3 * * *"] },
  // Only what the server itself writes is kept: errors, and how each of the
  // helper parrot's turns ended. A line and a trace for every message would
  // use up a day's allowance in a few hours, as each player sends their
  // position 15 times a second.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
